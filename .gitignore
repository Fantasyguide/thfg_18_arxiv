# ─── 本地版权字节 / 大体积 scratch ───────────────────────────────
# 纪律:本仓库不留任何版权字节。游戏 exe、解包资产、Ghidra 工程、
# 第三方仓库克隆一律只存在于 local/,不入库。
# 只保留 local/README.md 说明"什么放哪、怎么重建"。
local/*
!local/README.md

# ─── 工具产物 ───────────────────────────────────────────────────
__pycache__/
*.pyc
exports/
*.zip

# mod 的构建产物:由 mods/<版本>/<mod名>/native/Makefile 重建,不入库。
mods/**/native/*.dll
mods/**/native/*.lib
mods/**/native/*.exp
mods/**/native/*.o
mods/**/native/tests/build/
mods/**/native/build/
mods/**/native/cards/*.o

# 全函数符号 dump:由 tooling/ghidra/dump_funcs.py 重建,
# 且混入 ExpHP(上游无 LICENSE)函数名,不擅自转发。
*-funcs.json
mods/**/native/*.bin
mods/**/native/__pycache__/
mods/**/dist/

# card-expand 语音：构建产物。assets/voice/*.wav 本身入库（合成的是我们自己的内容；
# 若放原生 wav 请单独在这里加一行忽略它）
mods/th18.v1.00a/card-expand/patch/th18/voice/*.wav
mods/th18.v1.00a/card-expand/native/voice_ids.h

# tooling/steamless 的 .NET 构建产物
tooling/steamless/bin/
tooling/steamless/obj/

# card-expand：**原生切图**（`assets/ability/make_*_art.py` 从 local/ 现切）。
# 纪律：版权字节只在 local/，构建时取；这些是切出来的中间产物，别入库。
# 程序生成的图（SEASON_OPT/SEASON_SEED 等）照常入库 —— 只有「从原生 PNG 切出来」的才在这里。
# ⚠️ gitignore 没有行尾注释：注释必须单独成行，写在同一行会把整行变成一条匹配不到的规则。
# TH16 bullet/item.png / front00.png / pl0X(sub).png 切出来的
mods/th18.v1.00a/card-expand/assets/ability/season/SEASON_LASER.png
mods/th18.v1.00a/card-expand/assets/ability/season/SEASON_STRIP.png
mods/th18.v1.00a/card-expand/assets/ability/season/BULLET_*.png
mods/th18.v1.00a/card-expand/assets/ability/season/HIT_*.png
mods/th18.v1.00a/card-expand/assets/ability/season/LASER_*.png
mods/th18.v1.00a/card-expand/assets/ability/season/PT_*.png
mods/th18.v1.00a/card-expand/assets/ability/season/GLYPH_*.png
mods/th18.v1.00a/card-expand/assets/ability/season/OPT_*.png
# TH18 ascii_1280.png 切出来的字形
mods/th18.v1.00a/card-expand/assets/ability/font2/FONT2_*.png
# TH15 eff_sloweffect.png / front02.png 切出来的环与面板
mods/th18.v1.00a/card-expand/assets/ability/lolk/RING.png
mods/th18.v1.00a/card-expand/assets/ability/lolk/PANEL*.png

# dgVoodoo2 转译层（D3D9.dll + dgVoodoo.conf）：第三方二进制,不是我们的产物,
# 按「不入库」纪律留在工作区本地;要装的人自己去 dege.freeweb.hu 取。
mods/th18.v1.00a/stg 补丁/

# runtime/anm 测试夹具：我们自写源码 + thanm 编译出的产物，不入库（不留版权字节纪律同上）。
# .png 是 build-fixtures.sh 现生成的 8x8 纯色贴图源（喂给 thanm -c），同样是构建产物。
runtime/anm/tests/fixtures/*.anm
runtime/anm/tests/fixtures/*.png
runtime/anm/node_modules/

# thdat-nc 的本机构建和下载缓存；Windows 发布产物单独保留在 bin/。
tooling/thdat-nc/build/
tooling/thdat-nc/.cache/

# ★ 113 的升格音：TH13 原版 se_astralup.wav 的**构建期现取**产物（版权资产不入库；
#   源在 local/th13.v1.00c/dat/se_astralup.wav，见 assets/voice/derive_retail_se.py）
mods/th18.v1.00a/card-expand/assets/voice/ASTRALUP.wav
# ★ 112 的 UFO 出场音：TH12 原版 se_ufoalert.wav 的构建期现取产物（同上；
#   源在 local/th12.v1.00b/dat/se_ufoalert.wav）
mods/th18.v1.00a/card-expand/assets/voice/UFOALERT.wav
# ★ 109 / 111 的蓄力音：TH09 原版 se_charge00.wav / se_chargeup.wav 的构建期现取产物
#   （TH18 的 71 枚里没有这两枚；源在 local/th09.v1.50a/th09.dat，由 derive_retail_se.py 单抽）
mods/th18.v1.00a/card-expand/assets/voice/CHARGE00.wav
mods/th18.v1.00a/card-expand/assets/voice/CHARGEUP.wav
# ★ 110 的满 P 上涨音：TH10 原版 se_powerup.wav（**与 TH18 的同名文件不是同一次录音**）
mods/th18.v1.00a/card-expand/assets/voice/MOFPOWERUP.wav
# ★ 107 的森罗结界展开音：TH07 原版 se_border.wav（TH18 71 枚里没有）
mods/th18.v1.00a/card-expand/assets/voice/PCB_BORDER.wav
